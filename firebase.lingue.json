{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": { "source": "functions" },
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.apk"],
    "rewrites": [
      { "source": "/azione", "destination": "/azione/index.html" },
      { "source": "/s/pagina.js", "destination": "/s/pagina.js" },
      { "source": "/s/**", "function": { "functionId": "paginaPubblica", "region": "europe-west1" } }
    ]
  },
  "emulators": {
    "auth": { "port": 9199, "host": "127.0.0.1" },
    "firestore": { "port": 8180, "host": "127.0.0.1", "websocketPort": 9250 },
    "functions": { "port": 5101, "host": "127.0.0.1" },
    "pubsub": { "port": 8185, "host": "127.0.0.1" },
    "hosting": { "port": 5195, "host": "127.0.0.1" },
    "hub": { "port": 4410, "host": "127.0.0.1" },
    "logging": { "port": 4510, "host": "127.0.0.1" },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
