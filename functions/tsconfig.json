{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/pushDue.ts",
    "../src/lib/appRelease.ts",
    "../src/lib/appVersion.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
