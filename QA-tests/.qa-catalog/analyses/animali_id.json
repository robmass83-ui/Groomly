     {
      "name": "name",
      "type": "text",
      "required": true,
      "label": "Nome",
      "validations": [
       "obbligatorio: 'Il nome è obbligatorio'"
      ],
      "sampleValid": "Fido QA",
      "sampleInvalid": ""
     },
     {
      "name": "breed",
      "type": "text",
      "required": false,
      "label": "Razza",
      "sampleValid": "Meticcio"
     },
     {
      "name": "size",
      "type": "segmented",
      "required": false,
      "label": "Taglia",
      "options": [
       "Piccola",
       "Media",
       "Grande"
      ],
      "sampleValid": "Media"
     },
     {
      "name": "owner",
      "type": "text",
      "required": false,
      "label": "Proprietario",
      "validations": [
       "obbligatorio solo con requireOwner (nuova scheda): 'Il proprietario è obbligatorio'"
      ],
      "sampleValid": "Mario Rossi",
      "sampleInvalid": ""
     },
     {
      "name": "phone",
      "type": "tel",
      "required": true,
      "label": "Telefono",
      "validations": [
       "obbligatorio: 'Il telefono è obbligatorio'"
      ],
      "sampleValid": "+39 333 1234567",
      "sampleInvalid": ""
     },
     {
      "name": "email",
      "type": "email",
      "required": false,
      "label": "Email contatto (solo con campoEmail)",
      "validations": [
       "formato email: 'Inserisci un’email valida'"
      ],
      "sampleValid": "mario@example.com",
      "sampleInvalid": "non-una-email"
     },
     {
      "name": "character",
      "type": "segmented",
      "required": false,
      "label": "Carattere",
      "options": [
       "Bravo",
       "Agitato",
       "Mordace"
      ]
     },
     {
      "name": "alert",
      "type": "text",
      "required": false,
      "label": "Avviso critico",
      "sampleValid": "Allergico allo shampoo X"
     },
     {
      "name": "species",
      "type": "segmented",
      "required": false,
      "label": "Specie (Altri dettagli)",
      "options": [
       "Cane",
       "Gatto",
       "Altro"
      ]
     },
     {
      "name": "sex",
      "type": "segmented",
      "required": false,
      "label": "Sesso",
      "options": [
       "Maschio",
       "Femmina"
      ]
     },
     {
      "name": "ageCategory",
      "type": "segmented",
      "required": false,
      "label": "Età",
      "options": [
       "Cucciolo",
       "Giovane",
       "Adulto",
       "Anziano"
      ]
     },
     {
      "name": "birthYear",
      "type": "text",
      "required": false,
      "label": "Anno di nascita",
      "maxLength": 4,
      "validations": [
       "4 cifre, non nel futuro: 'Anno di 4 cifre, non nel futuro'"
      ],
      "sampleValid": "2019",
      "sampleInvalid": "abcd"
     },
     {
      "name": "weight",
      "type": "text",
      "required": false,
      "label": "Peso",
      "placeholder": "kg",
      "validations": [
       "numerico: 'Peso non valido'"
      ],
      "sampleValid": "12,5",
      "sampleInvalid": "abc"
     },
     {
      "name": "birthDay",
      "type": "text",
      "required": false,
      "label": "Compleanno - Giorno",
      "maxLength": 2,
      "validations": [
       "giorno/mese validi: 'Giorno o mese non validi'"
      ],
      "sampleValid": "15",
      "sampleInvalid": "45"
     },
     {
      "name": "birthMonth",
      "type": "text",
      "required": false,
      "label": "Compleanno - Mese",
      "maxLength": 2,
      "sampleValid": "06",
      "sampleInvalid": "13"
     },
     {
      "name": "clientType",
      "type": "segmented",
      "required": false,
      "label": "Cliente",
      "options": [
       "Mensile",
       "Occasionale"
      ]
     },
     {
      "name": "recurrenceWeeks",
      "type": "text",
      "required": false,
      "label": "Frequenza: ogni (settimane)",
      "maxLength": 2,
      "validations": [
       "1-52: 'Da 1 a 52 settimane'"
      ],
      "sampleValid": "8",
      "sampleInvalid": "99"
     },
     {
      "name": "servicePrice.<servizio>",
      "type": "text",
      "required": false,
      "label": "Prezzo € per servizio (Prezzi personalizzati)",
      "validations": [
       "^\\d+(\\.\\d{1,2})?$, virgola ammessa: 'Prezzo ≥ 0, al massimo due decimali'"
      ],
      "sampleValid": "25,50",
      "sampleInvalid": "12.345"
     },
     {
      "name": "serviceDuration.<servizio>",
      "type": "text",
      "required": false,
      "label": "Durata min per servizio",
      "validations": [
       "intero >=1: 'Minuti interi, minimo 1'"
      ],
      "sampleValid": "45",
      "sampleInvalid": "0"
     }
    ],
    "submit": {
     "label": "Salva",
     "destructive": false,
     "note": "errori inline solo dopo il primo submit"
    }
   },
