{
 "route": "/impostazioni/account",
 "sourceFile": "src/pages/AccountPage.tsx",
 "title": "Gestisci account Groomly",
 "requiresAuth": true,
 "authFailed": false,
 "rolesAllowed": [
  "titolare",
  "titolare-go",
  "collaboratore"
 ],
 "analyzedAsRole": "titolare",
 "elements": {
  "forms": [
   {
    "id": "titolare",
    "label": "Dialog Titolare",
    "fields": [
     {
      "name": "titolare",
      "type": "text",
      "required": false,
      "label": "Titolare",
      "sampleValid": "Valentina Piras"
     }
    ],
    "submit": {
     "label": "Salva",
     "destructive": false
    }
   },
   {
    "id": "toelettatura",
    "label": "Dialog Toelettatura",
    "fields": [
     {
      "name": "name",
      "type": "text",
      "required": false,
      "label": "Ragione sociale",
      "sampleValid": "Pet Spa QA"
     },
     {
      "name": "salonName",
      "type": "text",
      "required": false,
      "label": "Nome toelettatura",
      "sampleValid": "Pet Spa QA"
     },
     {
      "name": "vatNumber",
      "type": "text",
      "required": false,
      "label": "Partita IVA",
      "validations": [
       "^\\d{11}$ (IT rimosso): '11 cifre, senza IT'"
      ],
      "sampleValid": "12345678901",
      "sampleInvalid": "123"
     },
     {
      "name": "taxCode",
      "type": "text",
      "required": false,
      "label": "Codice fiscale",
      "validations": [
       "^[A-Z0-9]{16}$ maiuscolo: '16 lettere o numeri'"
      ],
      "sampleValid": "RSSMRA80A01H501U",
      "sampleInvalid": "abc"
     },
     {
      "name": "phone",
      "type": "tel",
      "required": false,
      "label": "Telefono",
      "sampleValid": "079 109053"
     },
     {
      "name": "address",
      "type": "text",
      "required": false,
      "label": "Indirizzo (autocomplete)",
      "sampleValid": "Via Roma 36, Napoli"
     }
    ],
    "submit": {
     "label": "Salva",
     "destructive": false,
     "note": "IVA e CF vuoti ammessi"
    }
   },
   {
    "id": "password",
    "label": "Dialog Password (scheda sicurezza)",
    "fields": [
     {
      "name": "current",
      "type": "password",
      "required": false,
      "label": "Password attuale",
      "sampleValid": "(password account)",
      "sampleInvalid": ""
     },
     {
      "name": "new",
      "type": "password",
      "required": false,
      "label": "Nuova password",
      "validations": [
       "min 8: toast 'Minimo 8 caratteri'"
      ],
      "sampleValid": "NuovaPass123!",
      "sampleInvalid": "abc"
     }
    ],
    "submit": {
     "label": "Salva",
     "destructive": false
    }
   },
   {
    "id": "email",
    "label": "Dialog Cambia email",
    "fields": [
     {
      "name": "email",
      "type": "email",
      "required": false,
      "label": "Nuova email",
      "validations": [
       "deve contenere @: toast 'Inserisci un’email valida'"
      ],
      "sampleValid": "nuova@example.com",
      "sampleInvalid": "senza-chiocciola"
     },
     {
      "name": "current",
      "type": "password",
      "required": false,
      "label": "Password attuale",
      "sampleValid": "(password account)"
     }
    ],
    "submit": {
     "label": "Salva",
     "destructive": false
    }
   },
   {
    "id": "orari",
    "label": "Dialog Orari di apertura (autosave)",
    "fields": [
     {
      "name": "<giorno> Dalle",
      "type": "time",
      "required": false,
      "label": "Lun-Sab Dalle",
      "sampleValid": "09:00"
     },
     {
      "name": "<giorno> Alle",
      "type": "time",
      "required": false,
      "label": "Lun-Sab Alle",
      "sampleValid": "13:00"
     }
    ],
    "submit": {
     "label": "(nessuno, salva alla modifica)",
     "destructive": false
    }
   },
   {
    "id": "logo",
    "label": "Cambia logo",
    "fields": [
     {
      "name": "logo",
      "type": "file",
      "required": false,
      "label": "account-logo",
      "accept": "image/*",
      "sampleValid": "PNG/JPG",
      "sampleInvalid": "file troppo grande -> toast"
     }
    ],
    "submit": {
     "label": "(upload immediato)",
     "destructive": false
    }
   }
  ],
  "buttons": [
   {
    "label": "Info personali",
    "destructive": false,
    "opens": "scheda ?scheda=personali"
   },
   {
    "label": "Sicurezza",
    "destructive": false,
    "opens": "scheda ?scheda=sicurezza"
   },
   {
    "label": "Privacy e dati",
    "destructive": false,
    "opens": "scheda ?scheda=privacy"
   },
   {
