{
 "route": "/listino/gestione",
 "sourceFile": "src/pages/PriceSheetManagePage.tsx",
 "title": "Gestione listino",
 "requiresAuth": true,
 "authFailed": false,
 "rolesAllowed": [
  "titolare",
  "titolare-go"
 ],
 "analyzedAsRole": "titolare",
 "elements": {
  "forms": [
   {
    "id": "intestazione",
    "label": "Intestazione (autosave a ogni modifica)",
    "fields": [
     {
      "name": "logo",
      "type": "file",
      "required": false,
      "label": "Carica logo / Cambia logo",
      "accept": "image/*",
      "sampleValid": "PNG con sfondo trasparente",
      "sampleInvalid": "file non immagine -> toast"
     },
     {
      "name": "descrizione",
      "type": "text",
      "required": false,
      "label": "Descrizione",
      "sampleValid": "Servizio di toelettatura"
     },
     {
      "name": "colore",
      "type": "swatch",
      "required": false,
      "label": "Colore del foglio",
      "options": [
       "#B8285E",
       "#3A5BA0",
       "#15905B",
       "#B4561E",
       "#1D1A1B"
      ]
     }
    ],
    "submit": {
     "label": "(autosave)",
     "destructive": false
    }
   },
   {
    "id": "note-taglia",
    "label": "Nota sotto la taglia (x3, autosave)",
    "fields": [
     {
      "name": "noteTaglia.<taglia>",
      "type": "textarea",
      "required": false,
      "label": "Nota sotto la taglia",
      "sampleValid": "Tosatura a partire da 55 €"
     }
    ],
    "submit": {
     "label": "(autosave)",
     "destructive": false
    }
   },
   {
    "id": "testi",
    "label": "Testi (autosave; punti ripuliti al blur)",
    "fields": [
     {
      "name": "info.intro",
      "type": "textarea",
      "required": false,
      "label": "Informazioni importanti · frase iniziale",
      "sampleValid": "I prezzi sono indicativi"
     },
     {
      "name": "info.punti",
      "type": "textarea",
      "required": false,
      "label": "Punti elenco (uno per riga)",
      "sampleValid": "nodi\nfeltri"
     },
     {
      "name": "info.chiusura",
      "type": "textarea",
      "required": false,
      "label": "Frase finale"
     },
     {
      "name": "avviso.titolo",
      "type": "text",
      "required": false,
      "label": "Avviso · titolo",
      "sampleValid": "Niente cani infestati"
     },
     {
      "name": "avviso.punti",
      "type": "textarea",
      "required": false,
      "label": "Avviso · punti (uno per riga)"
     },
     {
      "name": "saluto",
      "type": "text",
      "required": false,
      "label": "Saluto finale",
      "sampleValid": "Grazie per la fiducia!"
     }
    ],
    "submit": {
     "label": "(autosave)",
     "destructive": false
    }
   },
   {
    "id": "razza",
    "label": "Sheet Nuova razza / Modifica razza",
    "fields": [
     {
      "name": "breed-name",
      "type": "text",
      "required": true,
      "label": "Nome sul listino (senza \"Tipo\")",
      "placeholder": "Es. Barboncino toy",
      "validations": [
       "non vuoto: toast 'Scrivi il nome della razza'"
      ],
      "sampleValid": "Barboncino toy",
      "sampleInvalid": ""
     },
     {
      "name": "taglia",
      "type": "segmented",
      "required": false,
      "label": "Taglia",
      "options": [
       "Piccola",
       "Media",
       "Grande"
      ],
      "sampleValid": "Piccola"
     },
     {
      "name": "voce.nome",
      "type": "text",
      "required": true,
      "label": "Nome servizio n",
      "validations": [
       "non vuoto, altrimenti toast 'Il listino non è stato salvato. Controlla nomi e prezzi.'"
      ],
      "sampleValid": "Bagno",
      "sampleInvalid": ""
     },
     {
      "name": "voce.tipo",
      "type": "select",
      "required": false,
      "label": "Tipo <servizio>",
      "options": [
       "da",
       "fisso",
       "valutaz."
      ],
      "sampleValid": "fisso"
     },
     {
      "name": "voce.prezzo",
      "type": "text",
      "required": false,
      "label": "Prezzo <servizio> (€; nascosto se valutaz.)",
      "validations": [
       "non negativo"
      ],
      "sampleValid": "35",
      "sampleInvalid": "-5"
     }
    ],
    "submit": {
     "label": "Salva",
     "destructive": false
    }
   }
  ],
  "buttons": [
   {
    "label": "Carica logo / Cambia logo",
    "destructive": false,
    "opens": "file picker"
   },
   {
    "label": "Rimuovi logo",
    "destructive": true,
    "opens": "rimuove il logo subito (solo se c'è logo)"
