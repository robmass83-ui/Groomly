   },
   {
    "label": "Razza",
    "destructive": false,
    "opens": "sheet:Nuova razza"
   },
   {
    "label": "<nome razza>",
    "destructive": false,
    "opens": "sheet:Modifica razza"
   },
   {
    "label": "Sposta su/giù <razza> o <sezione>",
    "destructive": false
   },
   {
    "label": "Nascondi/Mostra <sezione> (Taglia piccola/media/grande, Bagno + tosatura, Servizi extra, Informazioni importanti, Avviso pulci e zecche, Compresi nel bagno, Saluto finale)",
    "destructive": false
   },
   {
    "label": "Elimina razza (cestino)",
    "destructive": true,
    "opens": "dialog:Eliminare questa razza?"
   },
   {
    "label": "Duplica",
    "destructive": false
   },
   {
    "label": "Salva",
    "destructive": false
   },
   {
    "label": "Cambia icona",
    "destructive": false,
    "opens": "griglia icone"
   },
   {
    "label": "Togli servizio (×)",
    "destructive": true
   },
   {
    "label": "Bagno / Bagno + tosatura / Bagno + sistemazione / Pelo corto / Pelo lungo / Tosatura / + Personalizzato",
    "destructive": false,
    "opens": "aggiunge una voce di prezzo"
   },
   {
    "label": "Chiudi (sheet)",
    "destructive": false
   }
  ],
  "links": [
   {
    "label": "Indietro",
    "href": "/listino"
   },
