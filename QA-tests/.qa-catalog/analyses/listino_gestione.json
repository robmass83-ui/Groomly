 },
 "flows": [
  "Cambiare logo, descrizione, colore (autosave)",
  "Aggiungere una razza con voci di prezzo",
  "Modificare, duplicare, spostare, eliminare una razza (con conferma)",
  "Riordinare e nascondere le sezioni del foglio",
  "Modificare note taglia, testi informativi, avviso, saluto",
  "Collegamento a Info personali per nome/indirizzo/telefono",
  "Collaboratore reindirizzato a /impostazioni"
 ],
 "assertions": [
  "Titolo 'Gestione listino' con sottotitolo 'Intestazione, razze, sezioni e testi'",
  "Contatori razze per taglia (7/11/10 nel seed) coerenti con gli elenchi",
  "Salva con nome vuoto -> toast 'Scrivi il nome della razza'",
  "Primo 'Sposta su' e ultimo 'Sposta giù' disabilitati",
  "Elimina razza apre conferma con Annulla senza cancellare",
  "Nascondi sezione cambia in Mostra e attenua il nome"
 ],
 "api": [
