rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOperator() {
      return signedIn() && (
        request.auth.token.email.lower() == 'laura.masala@tiscali.it'
        || request.auth.token.email.lower() == 'masala.roberto@hotmail.it'
      );
    }
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }
    function owns(salonId) {
      return signedIn() && exists(accountPath()) && get(accountPath()).data.salonId == salonId;
    }
    function fileOk() {
      return signedIn() && (!('thumb' in request.resource.data) || request.resource.data.thumb.size() < 25000);
    }

    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOperator());
      allow create: if signedIn() && request.auth.uid == uid
        && (
          (request.resource.data.salonId == uid
            && request.resource.data.role == 'titolare'
            && request.resource.data.legacy == false)
          || (isOperator()
            && request.resource.data.salonId == 'shared'
            && request.resource.data.role == 'titolare'
            && request.resource.data.legacy == true)
        );
      allow update: if signedIn() && request.auth.uid == uid
        && (
          (request.resource.data.salonId == resource.data.salonId
            && request.resource.data.role == resource.data.role
            && request.resource.data.legacy == resource.data.legacy)
          || (isOperator()
            && request.resource.data.salonId == 'shared'
            && request.resource.data.role == 'titolare'
            && request.resource.data.legacy == true)
        );
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.legacy == false;
    }

    match /salon/shared/files/{fileId} {
      allow read: if isOperator() || owns('shared');
      allow delete: if isOperator() || owns('shared');
      allow create, update: if (isOperator() || owns('shared')) && fileOk();

      match /full/{part} {
        allow read, delete: if isOperator() || owns('shared');
        allow create, update: if (isOperator() || owns('shared')) && request.resource.data.dati.size() <= 716800;
      }

      match /chunks/{n} {
        allow read, delete: if isOperator() || owns('shared');
        allow create, update: if (isOperator() || owns('shared')) && request.resource.data.dati.size() <= 614400;
      }
    }
    match /salon/shared/{kind}/{id} {
      allow read: if isOperator() || owns('shared');
      allow write: if (isOperator() || owns('shared')) && kind != 'files';
    }
    match /salon/shared/{kind}/{id}/{rest=**} {
      allow read: if isOperator() || owns('shared');
      allow write: if (isOperator() || owns('shared')) && kind != 'files';
    }

    match /salons/{salonId}/settings/main {
      allow read: if owns(salonId) || isOperator();
    }
    match /salons/{salonId}/files/{fileId} {
      allow read: if owns(salonId);
      allow delete: if owns(salonId);
      allow create, update: if owns(salonId) && fileOk();

      match /full/{part} {
        allow read, delete: if owns(salonId);
        allow create, update: if owns(salonId) && request.resource.data.dati.size() <= 716800;
      }

      match /chunks/{n} {
        allow read, delete: if owns(salonId);
        allow create, update: if owns(salonId) && request.resource.data.dati.size() <= 614400;
      }
    }
    match /salons/{salonId}/{kind}/{id} {
      allow read: if owns(salonId);
      allow write: if owns(salonId) && kind != 'files';
    }
    match /salons/{salonId}/{kind}/{id}/{rest=**} {
      allow read: if owns(salonId);
      allow write: if owns(salonId) && kind != 'files';
    }

    // Solo le Cloud Functions scrivono i limiti di invio. Il client non li legge.
    match /emailRateLimits/{id} {
      allow read, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
