rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOperator() {
      return signedIn() && (
        request.auth.token.email.lower() == 'laura.masala@tiscali.it'
        || request.auth.token.email.lower() == 'masala.roberto@hotmail.it'
      );
    }
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }
    function owns(salonId) {
      return signedIn() && exists(accountPath()) && get(accountPath()).data.salonId == salonId;
    }
    function memberRole() {
      return 'role' in get(accountPath()).data ? get(accountPath()).data.role : 'titolare';
    }
    function proEnabled(salonId) {
      return salonId == 'shared'
        ? exists(/databases/$(database)/documents/salon/shared/pro/main)
          && get(/databases/$(database)/documents/salon/shared/pro/main).data.enabled == true
        : exists(/databases/$(database)/documents/salons/$(salonId)/pro/main)
          && get(/databases/$(database)/documents/salons/$(salonId)/pro/main).data.enabled == true;
    }
    function canUse(salonId) {
      return signedIn()
        && exists(accountPath())
        && get(accountPath()).data.salonId == salonId
        && (
          memberRole() == 'titolare'
          || ((memberRole() == 'socio' || memberRole() == 'collaboratore') && proEnabled(salonId))
        );
    }
    function ownerRank(salonId) {
      return canUse(salonId) && (memberRole() == 'titolare' || memberRole() == 'socio');
    }
    function fileOk() {
      return signedIn() && (!('thumb' in request.resource.data) || request.resource.data.thumb.size() < 25000);
    }
    function pushPrefsOk() {
      return request.resource.data.keys().hasOnly(['enabled', 'updates', 'complete', 'completeAfterMin', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updates is bool
        && request.resource.data.complete is bool
        && request.resource.data.completeAfterMin is int
        && request.resource.data.completeAfterMin >= 0
        && request.resource.data.completeAfterMin <= 1440
        && request.resource.data.updatedAt is string;
    }
    function pushDeviceOk() {
      return request.resource.data.keys().hasOnly(['token', 'platform', 'appVersion', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.appVersion is string
        && request.resource.data.updatedAt is string;
    }

    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOperator());
      allow create: if signedIn() && request.auth.uid == uid
        && (
          (request.resource.data.salonId == uid
            && request.resource.data.role == 'titolare'
            && request.resource.data.legacy == false)
          || (isOperator()
            && request.resource.data.salonId == 'shared'
            && request.resource.data.role == 'titolare'
            && request.resource.data.legacy == true)
        );
      allow update: if signedIn() && request.auth.uid == uid
        && (
          (request.resource.data.salonId == resource.data.salonId
            && request.resource.data.role == resource.data.role
            && request.resource.data.legacy == resource.data.legacy)
          || (isOperator()
            && request.resource.data.salonId == 'shared'
            && request.resource.data.role == 'titolare'
            && request.resource.data.legacy == true)
        );
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.legacy == false;
    }

    match /accounts/{uid}/push/{docId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && docId == 'prefs' && pushPrefsOk();
    }

    match /accounts/{uid}/devices/{deviceId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && pushDeviceOk();
    }

    match /pushDeliveries/{id} {
      allow read, write: if false;
    }

    match /salon/shared/pro/{docId} {
      allow read: if isOperator() || canUse('shared');
      allow write: if false;
    }
    match /salon/shared/members/{memberId} {
      allow read: if isOperator() || canUse('shared');
      allow write: if false;
    }
    match /salon/shared/dogs/{dogId} {
      allow read: if isOperator() || canUse('shared');
      allow create: if isOperator() || ownerRank('shared')
        || (canUse('shared') && memberRole() == 'collaboratore' && request.resource.data.status == 'attivo');
      allow update: if isOperator() || ownerRank('shared')
        || (canUse('shared')
            && memberRole() == 'collaboratore'
            && resource.data.status == 'attivo'
            && request.resource.data.status == 'attivo');
      allow delete: if isOperator() || ownerRank('shared');
    }
    match /salon/shared/appointments/{appointmentId} {
      allow read: if isOperator() || canUse('shared');
      allow create: if isOperator() || canUse('shared');
      allow delete: if isOperator() || ownerRank('shared');
      allow update: if isOperator() || ownerRank('shared')
        || (canUse('shared')
            && memberRole() == 'collaboratore'
            && (
              !('status' in resource.data)
              || resource.data.status != 'completato'
              || request.resource.data.get('assigneeUid', '') == resource.data.get('assigneeUid', '')
            ));
    }
    match /salon/shared/files/{fileId} {
      function photoFile(data) {
        return data.kind == 'foto'
          && data.owner is string
          && (data.owner.matches('^dog:.*') || data.owner.matches('^appointment:.*'));
      }
      function collaboratorePhoto() {
        return canUse('shared') && memberRole() == 'collaboratore';
      }
      function parentPhoto() {
        return exists(/databases/$(database)/documents/salon/shared/files/$(fileId))
          && photoFile(get(/databases/$(database)/documents/salon/shared/files/$(fileId)).data);
      }

      allow read: if isOperator() || canUse('shared');
      allow delete: if isOperator() || ownerRank('shared')
        || (collaboratorePhoto() && photoFile(resource.data));
      allow create: if fileOk()
        && (isOperator() || ownerRank('shared') || (collaboratorePhoto() && photoFile(request.resource.data)));
      allow update: if fileOk()
        && (isOperator() || ownerRank('shared')
          || (collaboratorePhoto() && photoFile(resource.data) && photoFile(request.resource.data)));

      match /full/{part} {
        allow read: if isOperator() || canUse('shared');
        allow delete: if isOperator() || ownerRank('shared') || (collaboratorePhoto() && parentPhoto());
        allow create, update: if (isOperator() || ownerRank('shared') || (collaboratorePhoto() && parentPhoto()))
          && request.resource.data.dati.size() <= 716800;
      }

      match /chunks/{n} {
        allow read: if isOperator() || canUse('shared');
        allow delete: if isOperator() || ownerRank('shared') || (collaboratorePhoto() && parentPhoto());
        allow create, update: if (isOperator() || ownerRank('shared') || (collaboratorePhoto() && parentPhoto()))
          && request.resource.data.dati.size() <= 614400;
      }
    }
    match /salon/shared/{kind}/{id} {
      allow read: if isOperator() || canUse('shared');
      allow write: if (isOperator() || ownerRank('shared')) && kind != 'files' && kind != 'pro' && kind != 'members';
    }
    match /salon/shared/{kind}/{id}/{rest=**} {
      allow read: if isOperator() || canUse('shared');
      allow write: if (isOperator() || ownerRank('shared')) && kind != 'files' && kind != 'pro' && kind != 'members';
    }

    match /invites/{token} {
      allow read, write: if false;
    }

    match /salons/{salonId}/settings/main {
      allow read: if canUse(salonId) || isOperator();
    }
    match /salons/{salonId}/pro/{docId} {
      allow read: if canUse(salonId) || isOperator();
      allow write: if false;
    }
    match /salons/{salonId}/members/{memberId} {
      allow read: if canUse(salonId);
      allow write: if false;
    }
    match /salons/{salonId}/dogs/{dogId} {
      allow read: if canUse(salonId);
      allow create: if ownerRank(salonId)
        || (canUse(salonId) && memberRole() == 'collaboratore' && request.resource.data.status == 'attivo');
      allow update: if ownerRank(salonId)
        || (canUse(salonId)
            && memberRole() == 'collaboratore'
            && resource.data.status == 'attivo'
            && request.resource.data.status == 'attivo');
      allow delete: if ownerRank(salonId);
    }
    match /salons/{salonId}/appointments/{appointmentId} {
      allow read: if canUse(salonId);
      allow create: if canUse(salonId);
      allow delete: if ownerRank(salonId);
      allow update: if ownerRank(salonId)
        || (canUse(salonId)
            && memberRole() == 'collaboratore'
            && (
              !('status' in resource.data)
              || resource.data.status != 'completato'
              || request.resource.data.get('assigneeUid', '') == resource.data.get('assigneeUid', '')
            ));
    }
    match /salons/{salonId}/files/{fileId} {
      function photoFile(data) {
        return data.kind == 'foto'
          && data.owner is string
          && (data.owner.matches('^dog:.*') || data.owner.matches('^appointment:.*'));
      }
      function collaboratorePhoto(salonId) {
        return canUse(salonId) && memberRole() == 'collaboratore';
      }
      function parentPhoto(salonId, fileId) {
        return exists(/databases/$(database)/documents/salons/$(salonId)/files/$(fileId))
          && photoFile(get(/databases/$(database)/documents/salons/$(salonId)/files/$(fileId)).data);
      }

      allow read: if canUse(salonId);
      allow delete: if ownerRank(salonId)
        || (collaboratorePhoto(salonId) && photoFile(resource.data));
      allow create: if fileOk()
        && (ownerRank(salonId) || (collaboratorePhoto(salonId) && photoFile(request.resource.data)));
      allow update: if fileOk()
        && (ownerRank(salonId)
          || (collaboratorePhoto(salonId) && photoFile(resource.data) && photoFile(request.resource.data)));

      match /full/{part} {
        allow read: if canUse(salonId);
        allow delete: if ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId));
        allow create, update: if (ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId)))
          && request.resource.data.dati.size() <= 716800;
      }

      match /chunks/{n} {
        allow read: if canUse(salonId);
        allow delete: if ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId));
        allow create, update: if (ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId)))
          && request.resource.data.dati.size() <= 614400;
      }
    }
    match /salons/{salonId}/{kind}/{id} {
      allow read: if canUse(salonId);
      allow write: if ownerRank(salonId) && kind != 'files' && kind != 'pro' && kind != 'members';
    }
    match /salons/{salonId}/{kind}/{id}/{rest=**} {
      allow read: if canUse(salonId);
      allow write: if ownerRank(salonId) && kind != 'files' && kind != 'pro' && kind != 'members';
    }

    // Solo le Cloud Functions scrivono i limiti di invio. Il client non li legge.
    match /emailRateLimits/{id} {
      allow read, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
