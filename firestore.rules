rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOperator() {
      return signedIn() && request.auth.token.admin == true;
    }
    function salonKindWritable(kind) {
      return kind == 'services'
        || kind == 'closures'
        || kind == 'settings'
        || kind == 'meta'
        || kind == 'deletedDogs';
    }
    function completedFieldsHeld() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['total', 'paymentMethod', 'actualDurationMin', 'status', 'assigneeUid']);
    }
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }
    function owns(salonId) {
      return signedIn() && exists(accountPath()) && get(accountPath()).data.salonId == salonId;
    }
    function memberRole() {
      return 'role' in get(accountPath()).data ? get(accountPath()).data.role : 'titolare';
    }
    function proEnabled(salonId) {
      return salonId == 'shared'
        ? exists(/databases/$(database)/documents/salon/shared/pro/main)
          && get(/databases/$(database)/documents/salon/shared/pro/main).data.enabled == true
        : exists(/databases/$(database)/documents/salons/$(salonId)/pro/main)
          && get(/databases/$(database)/documents/salons/$(salonId)/pro/main).data.enabled == true;
    }
    function canUse(salonId) {
      return signedIn()
        && exists(accountPath())
        && get(accountPath()).data.salonId == salonId
        && (
          memberRole() == 'titolare'
          || ((memberRole() == 'socio' || memberRole() == 'collaboratore') && proEnabled(salonId))
          || (salonId != 'shared'
            && exists(/databases/$(database)/documents/salons/$(salonId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/salons/$(salonId)/members/$(request.auth.uid)).data.accessWithoutPro == true)
        );
    }
    function accountSalonIs(salonId) {
      return signedIn()
        && exists(accountPath())
        && get(accountPath()).data.salonId == salonId;
    }
    function ownerRank(salonId) {
      return canUse(salonId) && (memberRole() == 'titolare' || memberRole() == 'socio');
    }
    function dogIntact() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && 'species' in request.resource.data
        && request.resource.data.contact is map;
    }
    function fileOk() {
      return signedIn() && (!('thumb' in request.resource.data) || request.resource.data.thumb.size() < 25000);
    }
    function pushPrefsOk() {
      return request.resource.data.keys().hasOnly(['enabled', 'updates', 'complete', 'completeAfterMin', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updates is bool
        && request.resource.data.complete is bool
        && request.resource.data.completeAfterMin is int
        && request.resource.data.completeAfterMin >= 0
        && request.resource.data.completeAfterMin <= 1440
        && request.resource.data.updatedAt is string;
    }
    function pushDeviceOk() {
      return request.resource.data.keys().hasOnly(['token', 'platform', 'appVersion', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.appVersion is string
        && request.resource.data.updatedAt is string;
    }

    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOperator());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.salonId == uid
        && request.resource.data.role == 'titolare'
        && request.resource.data.legacy == false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.salonId == resource.data.salonId
        && request.resource.data.role == resource.data.role
        && request.resource.data.legacy == resource.data.legacy
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consensoMetriche']);
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.legacy == false && resource.data.salonId == uid;
    }

    match /accounts/{uid}/push/{docId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && docId == 'prefs' && pushPrefsOk();
    }

    match /accounts/{uid}/devices/{deviceId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && pushDeviceOk();
    }

    // Risposte di Assistenza e comunicazioni mirate: le scrivono solo le Cloud Functions.
    match /accounts/{uid}/avvisi/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /pushDeliveries/{id} {
      allow read, write: if false;
    }

    match /salon/shared/pro/{docId} {
      allow read: if isOperator() || canUse('shared');
      allow write: if false;
    }
    match /salon/shared/members/{memberId} {
      allow read: if isOperator() || canUse('shared');
      allow write: if false;
    }
    match /salon/shared/dogs/{dogId} {
      allow read: if isOperator() || canUse('shared');
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /salon/shared/appointments/{appointmentId} {
      allow read: if isOperator() || canUse('shared');
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /salon/shared/files/{fileId} {
      allow read: if isOperator() || canUse('shared');
      allow delete: if false;
      allow create: if false;
      allow update: if false;

      match /full/{part} {
        allow read: if isOperator() || canUse('shared');
        allow delete: if false;
        allow create: if false;
        allow update: if false;
      }

      match /chunks/{n} {
        allow read: if isOperator() || canUse('shared');
        allow delete: if false;
        allow create: if false;
        allow update: if false;
      }
    }
    match /salon/shared/{kind}/{id} {
      allow read: if isOperator() || canUse('shared');
      allow write: if false;
    }
    match /salon/shared/{kind}/{id}/{rest=**} {
      allow read: if isOperator() || canUse('shared');
      allow write: if false;
    }

    match /invites/{token} {
      allow read, write: if false;
    }

    match /salons/{salonId}/settings/main {
      allow read: if canUse(salonId) || isOperator() || accountSalonIs(salonId);
    }
    match /salons/{salonId}/pro/{docId} {
      allow read: if canUse(salonId) || isOperator() || accountSalonIs(salonId);
      allow write: if false;
    }
    match /salons/{salonId}/members/{memberId} {
      allow read: if canUse(salonId) || (accountSalonIs(salonId) && request.auth.uid == memberId);
      allow write: if false;
    }
    match /salons/{salonId}/dogs/{dogId} {
      allow read: if canUse(salonId);
      allow create: if ownerRank(salonId)
        || (canUse(salonId) && memberRole() == 'collaboratore' && request.resource.data.status == 'attivo' && dogIntact());
      allow update: if ownerRank(salonId)
        || (canUse(salonId)
            && memberRole() == 'collaboratore'
            && resource.data.status == 'attivo'
            && request.resource.data.status == 'attivo'
            && dogIntact());
      allow delete: if ownerRank(salonId);
    }
    match /salons/{salonId}/prodotti/{prodottoId} {
      function numeroVuotoOk(data, campo) {
        return !(campo in data) || data[campo] == null || (data[campo] is number && data[campo] >= 0);
      }
      function interoVuotoOk(data, campo) {
        return !(campo in data) || data[campo] == null || (data[campo] is int && data[campo] >= 0);
      }
      function consumoOk(data) {
        return !('mlPerCane' in data) || data.mlPerCane == null
          || (data.mlPerCane is map
              && data.mlPerCane.keys().hasOnly(['piccola', 'media', 'grande'])
              && data.mlPerCane.piccola is number && data.mlPerCane.piccola >= 0
              && data.mlPerCane.media is number && data.mlPerCane.media >= 0
              && data.mlPerCane.grande is number && data.mlPerCane.grande >= 0);
      }
      // La categoria non si controlla: le APK vecchie scrivono ancora le chiavi vecchie.
      function prodottoOk() {
        let data = request.resource.data;
        return data.nome is string
          && data.nome.size() > 0
          && data.nome.size() <= 120
          && (!('uso' in data) || data.uso in ['salone', 'vendita'])
          && interoVuotoOk(data, 'diluizione')
          && numeroVuotoOk(data, 'apertoIl')
          && interoVuotoOk(data, 'mesiDopoApertura')
          && numeroVuotoOk(data, 'costo')
          && numeroVuotoOk(data, 'prezzoVendita')
          && interoVuotoOk(data, 'giorniConsegna')
          && numeroVuotoOk(data, 'confrontoIl')
          && consumoOk(data);
      }
      allow read: if canUse(salonId);
      allow create, update: if canUse(salonId) && prodottoOk();
      allow delete: if ownerRank(salonId);
    }
    match /salons/{salonId}/appointments/{appointmentId} {
      allow read: if canUse(salonId);
      allow create: if canUse(salonId);
      allow delete: if ownerRank(salonId);
      allow update: if ownerRank(salonId)
        || (canUse(salonId)
            && memberRole() == 'collaboratore'
            && (
              !('status' in resource.data)
              || resource.data.status != 'completato'
              || completedFieldsHeld()
            ));
    }
    match /salons/{salonId}/files/{fileId} {
      function photoFile(data) {
        return data.kind == 'foto'
          && data.owner is string
          && (data.owner.matches('^dog:.*') || data.owner.matches('^appointment:.*'));
      }
      function collaboratorePhoto(salonId) {
        return canUse(salonId) && memberRole() == 'collaboratore';
      }
      function parentPhoto(salonId, fileId) {
        return exists(/databases/$(database)/documents/salons/$(salonId)/files/$(fileId))
          && photoFile(get(/databases/$(database)/documents/salons/$(salonId)/files/$(fileId)).data);
      }

      allow read: if canUse(salonId);
      allow delete: if ownerRank(salonId)
        || (collaboratorePhoto(salonId) && photoFile(resource.data));
      allow create: if fileOk()
        && (ownerRank(salonId) || (collaboratorePhoto(salonId) && photoFile(request.resource.data)));
      allow update: if fileOk()
        && (ownerRank(salonId)
          || (collaboratorePhoto(salonId) && photoFile(resource.data) && photoFile(request.resource.data)));

      match /full/{part} {
        allow read: if canUse(salonId);
        allow delete: if ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId));
        allow create, update: if (ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId)))
          && request.resource.data.dati.size() <= 716800;
      }

      match /chunks/{n} {
        allow read: if canUse(salonId);
        allow delete: if ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId));
        allow create, update: if (ownerRank(salonId) || (collaboratorePhoto(salonId) && parentPhoto(salonId, fileId)))
          && request.resource.data.dati.size() <= 614400;
      }
    }
    match /salons/{salonId}/interesse/{feature} {
      allow read: if ownerRank(salonId);
      allow create: if ownerRank(salonId)
        && request.resource.data.feature == feature
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /salons/{salonId}/coda/{id} {
      allow read: if canUse(salonId);
      allow create: if canUse(salonId)
        && request.resource.data.keys().hasOnly(['stato', 'motivo']);
      allow update: if canUse(salonId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'motivo']);
      allow delete: if ownerRank(salonId);
    }
    match /salons/{salonId}/buchiAttesa/{id} {
      allow read, create, update: if canUse(salonId);
      allow delete: if false;
    }
    // La lista d'attesa: la leggono e la scrivono i membri del salone. Il pubblico passa solo dalla funzione.
    match /salons/{salonId}/attesa/{id} {
      allow read, write: if canUse(salonId);
    }
    match /salons/{salonId}/offerteAttesa/{id} {
      allow read, write: if canUse(salonId);
    }
    match /salons/{salonId}/avvisiAttesa/{id} {
      allow read, write: if canUse(salonId);
    }
    // L'avviso della beta (invito, revoca, promemoria) lo legge solo il titolare; lo scrivono solo le functions.
    match /salons/{salonId}/avvisi/beta {
      allow read: if owns(salonId) && memberRole() == 'titolare';
      allow write: if false;
    }
    match /salons/{salonId}/{kind}/{id} {
      allow read: if canUse(salonId) && !(kind == 'avvisi' && id == 'beta');
      allow write: if ownerRank(salonId) && salonKindWritable(kind);
    }
    match /salons/{salonId}/{kind}/{id}/{rest=**} {
      allow read: if canUse(salonId) && !(kind == 'avvisi' && id == 'beta');
      allow write: if ownerRank(salonId) && salonKindWritable(kind);
    }

    // Programma beta: inviti, feedback e limiti li scrivono solo le Cloud Functions per operatori o titolari.
    // L'invito lo legge solo il titolare del salone (non socio, non collaboratore); lo storico e i feedback solo gli operatori.
    match /betaInviti/{salonId} {
      allow read: if isOperator() || (owns(salonId) && memberRole() == 'titolare');
      allow write: if false;
      match /storico/{id} {
        allow read: if isOperator();
        allow write: if false;
      }
    }
    match /betaFeedback/{id} {
      allow read: if isOperator();
      allow write: if false;
    }
    match /betaFeedbackLimiti/{id} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Solo le Cloud Functions scrivono i limiti di invio. Il client non li legge.
    match /emailRateLimits/{id} {
      allow read, write: if false;
    }

    match /placesRateLimits/{id} {
      allow read, write: if false;
    }

    match /pushRateLimits/{id} {
      allow read, write: if false;
    }

    match /pushSfide/{id} {
      allow read, write: if false;
    }

    match /mittentiLimiti/{id} {
      allow read, write: if false;
    }

    // I numeri della notte: solo totali, li scrive la function e li legge la Console.
    match /statsGiornaliere/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    // Il registro delle azioni admin lo scrivono solo le Cloud Functions.
    match /adminLog/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /avvisiLimiti/{id} {
      allow read, write: if false;
    }

    match /suggerimentiLimiti/{id} {
      allow read, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Comunicazioni di Groomly a tutti i saloni: le legge ogni account, le scrivono solo le Cloud Functions.
    match /avvisiSistema/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Console: stato delle richieste, risposte rapide e storico delle comunicazioni. Li scrivono solo le Cloud Functions.
    match /assistenza/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /assistenzaModelli/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /comunicazioni/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /comunicazioni/{id}/invii/{uid} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /suggerimenti/{id} {
      allow read: if isOperator();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.salonId == get(accountPath()).data.salonId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.categoria in ['bug', 'critica', 'miglioramento', 'manca', 'lingua', 'altro']
        && request.resource.data.testo is string
        && request.resource.data.testo.size() >= 10
        && request.resource.data.testo.size() <= 2000
        && request.resource.data.keys().hasOnly(['uid', 'salonId', 'email', 'categoria', 'testo', 'lingua', 'versione', 'creato']);
      allow update, delete: if false;
    }
  }
}
